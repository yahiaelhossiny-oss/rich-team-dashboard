{
  "name": "rich-team-dashboard",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "742193",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
